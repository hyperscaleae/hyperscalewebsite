NODE_ENV=production
PORT=3000
PORTAL_ORIGIN=https://YOUR-PORTAL-DOMAIN
PORTAL_DATA_DIR=/var/data/hyperscale
# Generate 32 random bytes encoded as 64 hexadecimal characters. Keep this key in the hosting secret store.
PORTAL_ENCRYPTION_KEY=
# Only used to create the first administrator when the private database is empty.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
